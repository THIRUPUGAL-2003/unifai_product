{
  "manifest_version": 3,
  "name": "YP-Raksha",
  "key": "",
  "version": "1.0.0",
  "description": "Enterprise AI Security Guard - Real-time Data Leak Prevention (DLP) for AI browsers.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "yp-raksha@gateway.guard",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://*/*", "http://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["endpoint.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
