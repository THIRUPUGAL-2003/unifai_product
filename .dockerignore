# Git
.git/
.gitignore
.github/

# Node.js
node_modules/
ui/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Data directories
data/

# Build outputs
dist/
build/
out/
ui/out/
*.tsbuildinfo
**/__pycache__/
*.pyc

# Local server binaries (the image builds its own)
/gateway_server.exe
/raksha_server.exe
transports/gateway-http/*.exe

# Guard build intermediates (only release/ files are copied into the image)
apps/browser-guard/build/
apps/browser-guard/dist/
apps/browser-guard/installer/pkg-root/
apps/browser-guard/installer/staging*/

# Logs
logs/
*.log

# Environment files
.env
.env.*
*.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Cache directories
.cache/
.parcel-cache/

# Documentation that's not needed for build
docs/
README.md
*.md

# CI/CD
ci/

# Plugin build artifacts
plugins/*/dist/

# Test directories
tests/
test/
__tests__/

# Temporary files
tmp/
temp/
.tmp/

# Go workspaces (local only)
go.work
go.work.sum