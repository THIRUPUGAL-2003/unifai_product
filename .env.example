# ==============================================================================
# Gateway — example environment (safe to commit). Copy to .env and fill secrets.
#   cp .env.example .env
# Then edit .env — live values live ONLY in .env (git-ignored).
# After changing .env: python apps/browser-guard/scripts/sync_config_from_env.py
# ==============================================================================

# 1. Server & Public Domain
SERVER_DOMAIN=https://your-domain.example.com
APP_PORT=6000
APP_HOST=0.0.0.0
# Docker network-proxy port (compose profile network-proxy) — NOT laptop MitM
PROXY_PORT=18182
CONTAINER_NAME=raksha_tech
# Laptop Guard local MitM bind (employee EXE) — must match Guard config sync
GATEWAY_PROXY_ADDR=127.0.0.1:18103
# Laptop Guard local PAC/health server (falls back to +1, +2 if busy)
PAC_HTTP_PORT=18195
# Dev start_app.sh / start_app.bat mitmweb UI port (local only)
MITM_WEB_PORT=18183
# Optional: docker compose --profile network-proxy container name
NETWORK_PROXY_CONTAINER_NAME=raksha_browser_ai_proxy
# Docker bridge network name (auto-created automatically by docker compose)
DOCKER_NETWORK=raksha-network

# UI & Dashboard Settings
UI_PORT=3100
# Backend API URL for UI dev server (default: http://localhost:6000 or your SERVER_DOMAIN)
GATEWAY_BACKEND_URL=http://localhost:6000

# Required shared authentication for Browser Guard agent requests and packages.
# Generate at least 32 random bytes locally; never commit the real value.
GATEWAY_GUARD_SECRET=replace-with-a-random-secret


# 2. Database
# Engine: sqlite | postgres | mysql | mariadb
# For zero-setup local development (no Docker / PostgreSQL needed), use sqlite:
DB_TYPE=sqlite
# For PostgreSQL (production or local Docker):
# DB_TYPE=postgres
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=gateway_new
DB_USER=agent_unify
DB_PASSWORD=change-me
DB_SSL_MODE=disable

# 4. Admin (change after first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# 5. Logging
LOG_LEVEL=info
LOG_STYLE=json
APP_DIR=/app/data

# Branding & Enterprise Customization
GATEWAY_BRAND_NAME=Raksha
GATEWAY_PRODUCT_NAME=Gateway
GATEWAY_PRODUCT_SUBTITLE=Real-time AI Knowledge Screening & Hazard Audit
GATEWAY_COMPANY_NAME=YesPanchi Group of Companies
GATEWAY_COMPANY_SHORT_NAME=YesPanchi
GATEWAY_COMPANY_LOGO=/yes-panchi-logo.png
GATEWAY_FOOTER_COPYRIGHT=© 2026 YesPanchi Group of Companies. All rights reserved. Gateway - Real-time AI Knowledge Screening & Hazard Audit
GATEWAY_FOOTER_SUBTITLE=Gateway - Real-time AI Knowledge Screening & Hazard Audit

# 6. Encryption at rest (use a long random secret in production)
GATEWAY_ENCRYPTION_KEY=change-me-long-random-secret

# Production DB: prefer require / verify-full when Postgres supports TLS
# DB_SSL_MODE=require

