# Python & Browser Guard builds
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv*/
venv/
venv*/
apps/browser-guard/.venv*/
apps/browser-guard/.secrets/
apps/browser-guard/extension/guard_extension.pem
apps/browser-guard/release/yp-raksha-unsigned.xpi
apps/browser-guard/build/
apps/browser-guard/dist/
apps/browser-guard/installer/staging/
apps/browser-guard/installer/staging-*/
