apps/browser-guard/release/Raksha_Guard.app/
apps/browser-guard/installer/pkg-root/

# Guard release binaries are uploaded to the server (tools/upload_guard_release.ps1), not committed.
apps/browser-guard/release/*.zip
apps/browser-guard/release/*.pkg
apps/browser-guard/release/*.exe
